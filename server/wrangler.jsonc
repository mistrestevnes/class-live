{
  // The server: holds lessons, votes, images and the passcode.
  // Students don't visit this address; the pages.dev site in ./site talks to it.
  "name": "class-live",
  "main": "src/index.js",
  "compatibility_date": "2026-06-01",
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "Classroom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Classroom"] }]
}
